# 이 리포는 bash 스크립트와 마크다운 문서로만 구성된다.
# 언어별 빌드 산출물 규칙은 해당하는 것이 없어 두지 않는다.

# 환경변수 (API 키 등)
.env

# 로그
*.log

# OS 생성물
.DS_Store
Thumbs.db

# 에디터
.vscode/
.idea/

# Claude Code 로컬 설정 (settings.local.json은 개인 환경값이라 공유하지 않는다)
.claude/
.claudeignore

# setup-team.sh가 만드는 역할별 스킬 격리 디렉터리 (런타임 생성물)
.team/

# log-hook이 쌓는 프롬프트·툴 로그 (런타임 생성물)
# 디렉터리 안에도 자체 .gitignore가 생기지만, 여기 명시해 의도를 드러낸다.
.claude-logs/
