#!/usr/bin/env bash
# say <파인|역할> <메시지...> — 입력 제출을 검증하고 busy 파인에는 큐로 전달한다.
set -e

# 연관 배열·mapfile·${var^^}는 bash 4+가 필요하다. macOS 기본 bash 3.2는 여기서 막는다.
[ "${BASH_VERSINFO[0]}" -ge 4 ] || { echo "bash 4+ 필요 (현재 $BASH_VERSION). macOS는 setup-mac.sh 안내대로 Homebrew bash로 실행하세요." >&2; exit 1; }

drain_only=false
drain_once=false
if [ "${1:-}" = "--drain" ] || [ "${1:-}" = "--drain-one" ]; then
    [ $# -eq 2 ] || { echo "usage: say [--drain|--drain-one] <pane|role>" >&2; exit 1; }
    drain_only=true
    [ "$1" = "--drain-one" ] && drain_once=true
    shift
else
    [ $# -ge 2 ] || { echo "usage: say <pane|role> <message...>" >&2; exit 1; }
fi

target="${1#:}"; shift

session=""
case "$target" in
    *:*) session="${target%%:*}"; target="${target#*:}" ;;
esac

# 역할은 @role로 찾고 이전 세션은 제목으로 폴백한다.
case "$target" in
    *[!0-9.]*)
        idx="$(tmux list-panes -t "$session:0" -F '#{pane_index} #{@role}' \
                | awk -v role="$target" '$2 == role { print $1; exit}')"
        if [ -z "$idx" ]; then
            idx="$(tmux list-panes -t "$session:0" -F '#{pane_index} #{pane_title}' \
                    | awk -v title="${target^^}" '$2 == title { print $1; exit}')"
        fi
        [ -n "$idx" ] || { echo "say: unknown role '$target'" >&2; exit 1; }
        target="0.$idx"
        ;;
    *.*) ;;                   # "0.3" 형태는 그대로
    *)   target="0.$target" ;; # "3" → "0.3"
esac

pane="$session:$target"

# ── 줄바꿈 처리 ──────────────────────────────────────────────
# 여러 턴으로 분리되지 않도록 줄바꿈을 구분자로 합친다.
msg="$*"

# 탭이 자동완성으로 해석되지 않도록 공백으로 바꾼다.
case "$msg" in
    *$'\t'*) msg="$(printf '%s' "$msg" | tr '\t' ' ')" ;;
esac

if [ "$msg" != "${msg%$'\n'*}" ] || [ "$msg" != "${msg#*$'\n'}" ]; then
    line_count=$(printf '%s\n' "$msg" | grep -c '')
    # 항목 경계는 남기되 빈 줄에서 생긴 중복 구분자는 제거한다.
    msg="$(printf '%s' "$msg" | sed ':a;N;$!ba;s/\n/ \/ /g' \
        | sed 's|\( */ *\)\{2,\}| / |g; s|^ */ *||; s| */ *$||; s/  */ /g')"
    if [ "$line_count" -gt 5 ]; then
        echo "say: NOTE - ${line_count}줄 메시지를 한 줄로 합쳐 보냈습니다." >&2
        echo "      긴 목록은 파일로 쓰고 경로만 넘기는 편이 읽기 쉽습니다:" >&2
        echo "      say $target \"[역할] 작업 목록: /tmp/tasks.md 참조. N건\"" >&2
    fi
fi

record_marker() {
    # 큐 등록 시점에 발신 파인의 보고를 기록해 Stop의 중복 알림을 막는다.
    [ -n "${TMUX_PANE:-}" ] || return 0
    local sender sender_key
    sender="$(tmux display-message -p -t "$TMUX_PANE" '#{session_id}:#{pane_id}' 2>/dev/null || true)"
    [ -n "$sender" ] || return 0
    sender_key="${sender//[^0-9A-Za-z]/_}"
    mkdir -p "$REPORT_DIR"
    : > "$REPORT_DIR/$sender_key"
}

pane_interrupted() {
    # 화면 하단에서 인터럽트 종료를 감지한다.
    local screen
    if [ "$#" -gt 0 ]; then
        screen="$1"
    else
        # 인라인 렌더링이라 화면 아래쪽이 빈 줄일 수 있어 빈 줄을 걷어낸 뒤 자른다.
        screen="$(tmux capture-pane -t "$pane" -p 2>/dev/null | grep -v '^[[:space:]]*$' | tail -15)"
    fi
    [ -n "$screen" ] || return 1
    printf '%s\n' "$screen" | grep -qE 'Interrupted( by user| ·)|Conversation interrupted'
}

is_busy() {
    # busy 마커를 우선하고 스피너·유예 시간으로 남은 마커를 회수한다.
    local marker="$BUSY_DIR/${state_key}" age screen
    if [ -f "$marker" ]; then
        age=$(( $(date +%s) - $(stat -c %Y "$marker" 2>/dev/null || stat -f %m "$marker" 2>/dev/null || echo 0) ))
        # 스피너가 멈춘 크래시까지 회수하는 최후 상한이다.
        if [ "$age" -ge "$HARD_CAP" ]; then
            rm -f "$marker"
            return 1
        fi
        # 경과시간 스피너는 Claude·Codex 공통의 실제 작업 신호다.
        screen="$(tmux capture-pane -t "$pane" -p 2>/dev/null | grep -v '^[[:space:]]*$' | tail -15)"
        printf '%s\n' "$screen" | grep -qE '\([0-9]+s( |·|$)' && return 0
        # 흔한 인터럽트는 즉시 회수하고, 문구가 없거나 달라도 아래 유예 후 회수한다.
        if pane_interrupted "$screen" || [ "$age" -ge "$STARTUP_GRACE" ]; then
            rm -f "$marker"
            return 1
        fi
        # 마커를 찍은 직후에는 스피너가 아직 렌더되지 않을 수 있다.
        return 0
    fi
    if [ -d "$BUSY_DIR" ]; then
        return 1
    fi
    tmux capture-pane -t "$pane" -p 2>/dev/null | tail -5 | grep -qE '\([0-9]+s( |·|$)'
}

# 파인 내부와 훅 호출이 같은 대상을 동일한 키로 참조하도록 한 번만 해석한다.
resolved_pane="$(tmux display-message -t "$pane" -p '#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null || true)"
if [[ ! "$resolved_pane" =~ ^[^:]+:[0-9]+\.[0-9]+$ ]]; then
    resolved_pane=""
fi

# 상태는 tmux 고유 ID로 격리하고, 큐는 논리 주소로 유지해 재시작 후 복구한다.
resolved_state="$(tmux display-message -t "$pane" -p '#{session_id}:#{pane_id}' 2>/dev/null || true)"
if [[ ! "$resolved_state" =~ ^\$[0-9]+:%[0-9]+$ ]]; then
    resolved_state="${resolved_pane:-$pane}"
fi
state_key="${resolved_state//[^0-9A-Za-z]/_}"

BUSY_DIR="${SAY_BUSY_DIR:-/tmp/team-busy}"
REPORT_DIR="${SAY_REPORT_DIR:-/tmp/team-say}"
STARTUP_GRACE=45
HARD_CAP=1800

deliver() {
    # 입력 제출을 검증하고 busy를 직접 표시한다. Codex에는 턴 시작 훅이 없다.
    mkdir -p "$BUSY_DIR" && touch "$BUSY_DIR/${state_key}"
    # -l: 메시지를 리터럴로 보내 "Enter" 같은 단어가 키 이름으로 해석되지 않게 한다.
    if ! tmux send-keys -t "$pane" -l -- "$msg"; then
        rm -f "$BUSY_DIR/${state_key}"
        return 1
    fi
    # TUI가 첫 Enter를 무시할 수 있어 간격을 두고 반복한다. 제출 후 빈 Enter는 무해하다.
    local enter_attempt
    for enter_attempt in 1 2 3; do
        sleep 0.3
        tmux send-keys -t "$pane" Enter || true
    done

    # 긴 메시지는 입력창에서 줄바꿈되므로 앞부분으로 잔류 여부를 검사한다.
    sleep 0.2
    local probe="${msg:0:40}"
    # 짧은 문자열은 안내 문구와 쉽게 겹쳐 전달 여부를 판별할 수 없다.
    [ "${#probe}" -ge 8 ] || return 0
    if tmux capture-pane -t "$pane" -p \
        | grep -E '^[[:space:]]*[›>]' | tail -n 1 | grep -qF -- "$probe"; then
        echo "say: WARNING - '$pane'에 메시지가 전달되지 않고 입력창에 남아있는 것으로 보입니다: $probe..." >&2
        # 제출 실패 시 busy를 되돌려 다음 큐 재시도가 막히지 않게 한다.
        rm -f "$BUSY_DIR/${state_key}"
        return 1
    fi
    return 0
}

# ── 유휴 대기 (백그라운드 큐) ────────────────────────────────
# busy 파인의 작업에 끼어들지 않도록 파인당 하나의 watcher가 FIFO 큐를 처리한다.
# SAY_NOWAIT=1은 작업 중단이 필요한 즉시 전송에 사용한다.
QUEUE_DIR="${SAY_QUEUE_DIR:-/tmp/team-say-queue}"
# 파인 내부와 훅에서 같은 큐를 사용하도록 해석된 논리 주소로 키를 만든다.
queue_key="${resolved_pane:-$pane}"
queue_file="$QUEUE_DIR/${queue_key//[^0-9A-Za-z]/_}"
lock_file="$queue_file.lock"

# PID 재사용까지 판별하고 owner 기록 전의 짧은 구간에는 5초 유예한다.
process_start_time() {
    # PID 재사용 판별에 쓸 프로세스 시작 시각을 읽는다.
    [ -r "/proc/$1/stat" ] || return 1
    awk '{print $22}' "/proc/$1/stat" 2>/dev/null
}

watcher_lock_is_orphaned() {
    # 소유자의 생존과 시작 시각으로 고아 락을 판별한다.
    [ -d "$lock_file" ] || return 1
    local owner pid started actual age
    owner="$(cat "$lock_file/owner" 2>/dev/null || true)"
    read -r pid started <<< "$owner"
    if [[ "$pid" =~ ^[0-9]+$ ]] && [[ "$started" =~ ^[0-9]+$ ]]; then
        actual="$(process_start_time "$pid" || true)"
        [ "$actual" != "$started" ]
        return
    fi
    age=$(( $(date +%s) - $(stat -c %Y "$lock_file" 2>/dev/null || stat -f %m "$lock_file" 2>/dev/null || echo 0) ))
    [ "$age" -ge 5 ]
}

reclaim_orphan_watcher_lock() {
    # 회수용 락으로 경합을 막고 고아 watcher 락을 제거한다.
    watcher_lock_is_orphaned || return 0
    local reclaim_lock="$lock_file.reclaim"
    mkdir "$reclaim_lock" 2>/dev/null || return 0
    if watcher_lock_is_orphaned; then
        rm -f "$lock_file/owner"
        rmdir "$lock_file" 2>/dev/null || true
    fi
    rmdir "$reclaim_lock" 2>/dev/null || true
}

queue_lock() {
    # 큐 변경을 원자적 mkdir로 잠그고 응답 없는 락의 대기 시간을 제한한다.
    local tries=0
    while ! mkdir "$queue_file.oplock" 2>/dev/null; do
        tries=$((tries + 1))
        if [ "$tries" -ge 100 ]; then
            rmdir "$queue_file.oplock" 2>/dev/null || true
            tries=0
        fi
        sleep 0.05
    done
}

queue_unlock() {
    # 큐 변경 락을 해제한다.
    rmdir "$queue_file.oplock" 2>/dev/null || true
}

target_busy=false
if [ -z "${SAY_NOWAIT:-}" ] && is_busy; then
    target_busy=true
fi

# Stop 훅은 다른 전달과 경합하면 기다리지 않고 다음 Stop이나 watcher에 맡긴다.
if [ "$drain_once" = true ] && [ "$target_busy" = true ]; then
    exit 0
fi

if [ "$drain_only" = false ] && { [ -n "${SAY_NOWAIT:-}" ] || [ "$target_busy" = false ]; }; then
    # 앞선 메시지가 없을 때만 직접 전송해 FIFO 순서를 유지한다.
    if [ -n "${SAY_NOWAIT:-}" ] || [ ! -s "$queue_file" ]; then
        deliver || exit 1
        record_marker
        exit 0
    fi
fi

mkdir -p "$QUEUE_DIR"
if [ "$drain_only" = false ]; then
    queue_lock
    printf '%s\n' "$msg" >> "$queue_file"
    queue_unlock
    record_marker
    if [ "$target_busy" = true ]; then
        echo "say: '$pane'이 작업 중 — 큐에 넣고 유휴가 되면 전송합니다(대기 $(grep -c '' "$queue_file")건)." >&2
    else
        echo "say: '$pane'의 기존 큐 뒤에 넣고 순서대로 전송합니다(대기 $(grep -c '' "$queue_file")건)." >&2
    fi
elif [ ! -s "$queue_file" ]; then
    exit 0
fi

# watcher는 파인당 하나만 유지한다. --drain-one은 Stop 훅에서 한 건만 처리한다.
process_queue() {
    # 항목별 전송 횟수를 제한하고 실패 상한에 도달한 항목은 기록 후 제거한다.
    if mkdir "$lock_file" 2>/dev/null; then
        local delivery_attempts=0 max_delivery_attempts=3
        watcher_pid="$BASHPID"
        watcher_started="$(process_start_time "$watcher_pid")"
        printf '%s %s\n' "$watcher_pid" "$watcher_started" > "$lock_file/owner"
        trap 'rm -f "$lock_file/owner"; rmdir "$lock_file" 2>/dev/null' EXIT
        # 빈 큐 확인·삭제도 같은 락에서 처리해 동시 append가 유실되지 않도록 한다.
        while true; do
            # 큐가 비면 대상 턴 종료를 기다리지 않고 watcher를 정리한다.
            queue_lock
            if [ ! -s "$queue_file" ]; then
                rm -f "$queue_file"
                queue_unlock
                break
            fi
            queue_unlock

            # 상태 판정 오류가 무한 대기로 이어지지 않도록 상한을 둔다.
            waited=0
            while is_busy && [ "$waited" -lt 600 ]; do
                sleep 3
                waited=$((waited + 1))
            done

            queue_lock
            if [ ! -s "$queue_file" ]; then
                rm -f "$queue_file"
                queue_unlock
                break
            fi
            # 전송 성공 후에만 첫 항목을 지운다. 동시 append는 큐 끝에만 추가된다.
            msg="$(head -n 1 "$queue_file")"
            queue_unlock

            [ -n "$msg" ] || continue
            if [ "$delivery_attempts" -lt "$max_delivery_attempts" ]; then
                delivery_attempts=$((delivery_attempts + 1))
                if ! deliver; then
                    if [ "$delivery_attempts" -lt "$max_delivery_attempts" ]; then
                        # 원문과 횟수를 유지한 채 다음 루프에서 다시 시도한다.
                        sleep 1
                        continue
                    fi
                    # watcher의 stderr는 폐기되므로 별도 파일에도 기록한다.
                    printf '%s say: dropped pane=%s attempts=%s message=%s\n' \
                        "$(date -Is)" "$pane" "$delivery_attempts" "$msg" >> "$QUEUE_DIR/dropped.log"
                    echo "say: WARNING - '$pane' 전송 ${delivery_attempts}회 실패, 큐 항목 제거: $msg" >&2
                fi
            fi
            queue_lock
            if ! { tail -n +2 "$queue_file" > "$queue_file.tmp" && mv "$queue_file.tmp" "$queue_file"; }; then
                queue_unlock
                continue
            fi
            queue_unlock
            delivery_attempts=0
            [ "$drain_once" = true ] && break
            # 연속 전송 시 입력창이 따라오도록 간격을 준다.
            sleep 1
        done
    fi
}

reclaim_orphan_watcher_lock
if [ "$drain_once" = true ]; then
    process_queue
else
    process_queue </dev/null >/dev/null 2>&1 &
    disown 2>/dev/null || true
fi
exit 0
